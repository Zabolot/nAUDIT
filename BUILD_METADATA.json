    "status": "PRODUCTION_READY",
    "created_at": "2024",
    "description": "Advanced Python Audit and Analysis Tool with Graph Visualization"
  },
  
  "builders": {
    "primary": {
      "name": "build_exe_fast.py",
      "lines": 180,
      "build_time_minutes": "2-3",
      "hidden_imports": 15,
      "description": "Optimized for production with minimal dependencies",
      "recommended": true
    },
    "alternative": {
      "name": "build_exe_v2_1.py",
      "lines": 250,
      "build_time_minutes": "3-5",
      "hidden_imports": 45,
      "description": "Full version with maximum compatibility"
    }
  },

  "launchers": {
    "powershell": {
      "name": "build.ps1",
      "description": "PowerShell launcher with auto-activation"
    },
    "cmd": {
      "name": "build.bat",
      "description": "CMD batch launcher for Windows"
    }
  },

  "components": {
    "gui": [
      {
        "file": "main_app.py",
        "role": "Entry point",
        "status": "OK"
      },
      {
        "file": "main_window_v4.py",
        "role": "Main window",
        "status": "OK"
      },
      {
        "file": "tree_widget.py",
        "role": "Error tree display",
        "lines": 480,
        "status": "OK"
      },
      {
        "file": "graph_visualizer.py",
        "role": "Graph visualization",
        "lines": 400,
        "is_new": true,
        "status": "OK"
      },
      {
        "file": "error_visualization.py",
        "role": "3-mode error panel",
        "lines": 150,
        "is_new": true,
        "status": "OK"
      }
    ]
  },

  "dependencies": {
    "python": "3.12.10",
    "pyinstaller": "6.16.0",
    "pyqt6": "6.10.0",
    "pyqt6_webengine": "6.10.0",
    "networkx": "3.4.2",
    "pyvis": "0.3.2",
    "matplotlib": "latest"
  },

  "build_parameters": {
    "onefile": true,
    "windowed": true,
    "noupx": true,
    "auto_overwrite": true
  },

  "documentation": [
    {
      "name": "START_BUILD_HERE.md",
      "purpose": "Quick start guide"
    },
    {
      "name": "QUICK_BUILD_GUIDE.md",
      "purpose": "5-minute quickstart"
    },
    {
      "name": "BUILDER_GUIDE_V2_1.md",
      "purpose": "Comprehensive guide"
    },
    {
      "name": "BUILDERS_SUMMARY.md",
      "purpose": "System overview"
    },
    {
      "name": "BUILDER_CREATION_REPORT.md",
      "purpose": "Technical report"
    },
    {
      "name": "FINAL_BUILD_READY.md",
      "purpose": "Project status"
    },
    {
      "name": "QUICK_COMMANDS.md",
      "purpose": "Command reference"
    }
  ],

  "quick_commands": {
    "build_primary": "python build_exe_fast.py",
    "build_full": "python build_exe_v2_1.py",
    "build_via_powershell": ".\\build.ps1",
    "build_via_cmd": "build.bat",
    "check_exe_created": "Test-Path dist\\nAUDIT.exe",
    "get_exe_size": "(Get-Item dist\\nAUDIT.exe).Length / 1MB",
    "run_exe": "& 'dist\\nAUDIT.exe'",
    "clean_build": "Remove-Item -Recurse build, dist -ErrorAction SilentlyContinue"
  },

  "expected_output": {
    "file_name": "nAUDIT.exe",
    "location": "dist\\nAUDIT.exe",
    "size_mb": "~220",
    "build_time_seconds": "120-180"
  },

